local function createSlider(name, key, min, max, step, cb)
    step = step or 1
    local cur = State[key] or min
    local h = Instance.new("Frame")
    h.Size = UDim2.new(1, -10, 0, 45)
    h.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
    h.BorderSizePixel = 0
    h.ZIndex = 52
    h.Parent = scroll
    Instance.new("UICorner", h).CornerRadius = UDim.new(0, 6)
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(0.6, 0, 0, 18)
    l.Position = UDim2.new(0, 10, 0, 4)
    l.BackgroundTransparency = 1
    l.Text = name .. ": " .. cur
    l.TextColor3 = THEME.Text
    l.Font = Enum.Font.Gotham
    l.TextSize = 11
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.ZIndex = 53
    l.Parent = h
    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(0.9, 0, 0, 6)
    bar.Position = UDim2.new(0.05, 0, 0.65, 0)
    bar.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    bar.BorderSizePixel = 0
    bar.ZIndex = 53
    bar.Parent = h
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((cur - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(0, 170, 90)
    fill.BorderSizePixel = 0
    fill.ZIndex = 53
    fill.Parent = bar
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    local dragging = false
    local function update(x)
        local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local raw = min + (max - min) * rel
        local val = math.floor(raw / step + 0.5) * step
        fill.Size = UDim2.new((val - min) / (max - min), 0, 1, 0)
        local disp = step < 1 and string.format("%.2f", val) or tostring(math.floor(val))
        l.Text = name .. ": " .. disp
        State[key] = val
        if cb then cb(val) end
    end
    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
           or input.UserInputType == Enum.UserInputType.Touch) then
            update(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

