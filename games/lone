end

local zoomConn = nil
local function enableZoom()
    if zoomConn then return end
    zoomConn = RunService.RenderStepped:Connect(function()
        if not State.Zoom or not Camera then return end
        local t = State.ZoomLevel
        local c = Camera.FieldOfView
        if math.abs(c - t) > 0.1 then
            Camera.FieldOfView = c + (t - c) * State.ZoomSpeed
        end
    end)
end
local function disableZoom()
    if zoomConn then zoomConn:Disconnect(); zoomConn = nil end
    if Camera then Camera.FieldOfView = 70 end
end

local speedConn = nil
local function enableSpeed()
    if speedConn then return end
    speedConn = RunService.Heartbeat:Connect(function()
        if not State.Speed or not Humanoid then return end
        if Humanoid.WalkSpeed ~= State.SpeedValue then Humanoid.WalkSpeed = State.SpeedValue end
    end)
end
local function disableSpeed()
    if speedConn then speedConn:Disconnect(); speedConn = nil end
    if Humanoid then Humanoid.WalkSpeed = 16 end
end

local infJumpConn = nil
local function enableInfJump()
    if infJumpConn then return end
    infJumpConn = UserInputService.JumpRequest:Connect(function()
        if not State.InfiniteJump or not Humanoid then return end
        Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end)
end
local function disableInfJump()
    if infJumpConn then infJumpConn:Disconnect(); infJumpConn = nil end
end

local antiFallConn = nil
local savedGravity = workspace.Gravity
local function enableAntiFall()
    if antiFallConn then return end
    savedGravity = workspace.Gravity
    workspace.Gravity = 0
    antiFallConn = RunService.Heartbeat:Connect(function()
        if not State.AntiFall or not RootPart then return end
        if RootPart.AssemblyLinearVelocity.Y < -1 then
            RootPart.AssemblyLinearVelocity = Vector3.new(RootPart.AssemblyLinearVelocity.X, 0, RootPart.AssemblyLinearVelocity.Z)
        end
    end)
end
local function disableAntiFall()
    if antiFallConn then antiFallConn:Disconnect(); antiFallConn = nil end
    workspace.Gravity = savedGravity
end

-- ==================== ITEM SPAWNER ====================
local remoteCache = {}
local function scanRemotes()
    remoteCache = {}
    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            table.insert(remoteCache, obj)
        end
    end
    return #remoteCache
end

local function tryFireGiveItem(itemName)
    if not itemName or itemName == "" then return false end
    if #remoteCache == 0 then scanRemotes() end
    local fired = 0
    for _, r in ipairs(remoteCache) do
        local n = r.Name:lower()
        if n:find("give") or n:find("spawn") or n:find("item") or n:find("drop") or n:find("pickup") or n:find("craft") then
            pcall(function() r:FireServer(itemName) end)
            pcall(function() r:FireServer("Give", itemName) end)
            pcall(function() r:FireServer("Spawn", itemName) end)
            fired = fired + 1
        end
    end
    return fired > 0
end

-- ==================== ANTI-KICK ====================
local antiKickHooked = false
local function enableAntiKick()
    if antiKickHooked then return end
    antiKickHooked = true
    pcall(function()
        local mt = getrawmetatable(game)
        local oldNamecall = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if State.AntiKick and (method == "Kick" or method == "kick") then
                return nil
            end
            return oldNamecall(self, ...)
        end)
        setreadonly(mt, true)
    end)
end

