local function buildCross()
    clearCrosshair()
    local s, g, t = State.CH_Size, State.CH_Gap, State.CH_Thickness
    local off = g + s/2
    local a = makeLine(s, t, 90, State.CH_Color); a.Position = UDim2.new(0.5, 0, 0.5, -off)
    local b = makeLine(s, t, 90, State.CH_Color); b.Position = UDim2.new(0.5, 0, 0.5, off)
    local c = makeLine(s, t, 0, State.CH_Color); c.Position = UDim2.new(0.5, -off, 0.5, 0)
    local d = makeLine(s, t, 0, State.CH_Color); d.Position = UDim2.new(0.5, off, 0.5, 0)
end

local function buildSwastika()
    clearCrosshair()
    local s, t = State.CH_Size, State.CH_Thickness
    local arm, hook = s, s * 0.55
    local a = makeLine(arm, t, 90, State.CH_Color); a.Position = UDim2.new(0.5, 0, 0.5, -arm/2)
    local b = makeLine(arm, t, 90, State.CH_Color); b.Position = UDim2.new(0.5, 0, 0.5, arm/2)
    local c = makeLine(arm, t, 0, State.CH_Color); c.Position = UDim2.new(0.5, -arm/2, 0.5, 0)
    local d = makeLine(arm, t, 0, State.CH_Color); d.Position = UDim2.new(0.5, arm/2, 0.5, 0)
    local e = makeLine(hook, t, 0, State.CH_Color); e.Position = UDim2.new(0.5, hook/2, 0.5, -arm + t/2)
    local f = makeLine(hook, t, 90, State.CH_Color); f.Position = UDim2.new(0.5, arm - t/2, 0.5, hook/2)
    local g = makeLine(hook, t, 0, State.CH_Color); g.Position = UDim2.new(0.5, -hook/2, 0.5, arm - t/2)
    local h = makeLine(hook, t, 90, State.CH_Color); h.Position = UDim2.new(0.5, -arm + t/2, 0.5, -hook/2)
end

local function buildStar()
    clearCrosshair()
    local s, t = State.CH_Size, State.CH_Thickness
    local topA, botA = {90, 210, 330}, {270, 30, 150}
    local side = s * math.sqrt(3)
    local function tri(angles)
        for i = 1, 3 do
            local a1, a2 = math.rad(angles[i]), math.rad(angles[i % 3 + 1])
            local cx = (math.cos(a1) + math.cos(a2)) / 2 * s
            local cy = (math.sin(a1) + math.sin(a2)) / 2 * s
            local dx = math.cos(a2) - math.cos(a1)
            local dy = math.sin(a2) - math.sin(a1)
            local ang = math.deg(math.atan2(dy, dx))
            local l = makeLine(side, t, -ang, State.CH_Color)
            l.Position = UDim2.new(0.5, cx, 0.5, -cy)
        end
    end
    tri(topA); tri(botA)
end

local function rebuildCrosshair()
    if State.CH_Mode == "swastika" then buildSwastika()
    elseif State.CH_Mode == "star" then buildStar()
    else buildCross() end
end
