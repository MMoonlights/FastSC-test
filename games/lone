-- ==================== AIMBOT ====================
local aimbotActive, currentAimbotTarget = false, nil

local function getAimbotPart(target)
    if not target then return nil end
    if State.AimTargetPart == "HumanoidRootPart" then
        return target:FindFirstChild("HumanoidRootPart")
    elseif State.AimTargetPart == "Nearest" then
        local camPos = Camera.CFrame.Position
        local best, bestD = nil, math.huge
        for _, p in ipairs(target:GetDescendants()) do
            if p:IsA("BasePart") then
                local d = (p.Position - camPos).Magnitude
                if d < bestD then best, bestD = p, d end
            end
        end
        return best
    end
    return target:FindFirstChild("Head") or target:FindFirstChild("HumanoidRootPart")
end

local function aimAt(target, smooth)
    if not target or not Camera then return end
    local part = getAimbotPart(target)
    if not part then return end
    local pos = part.Position
    if State.Prediction then
        local hrp = target:FindFirstChild("HumanoidRootPart")
        if hrp then
            local vel = hrp.AssemblyLinearVelocity or hrp.Velocity or Vector3.zero
            local dist = (pos - Camera.CFrame.Position).Magnitude
            pos = pos + vel * (dist / math.max(State.BulletSpeed, 1))
        end
    end
    local newCF = CFrame.new(Camera.CFrame.Position, pos)
    if smooth then
        Camera.CFrame = Camera.CFrame:Lerp(newCF, State.AimbotSmoothness)
    else
        Camera.CFrame = newCF
    end
end

local function isInFOV(part)
    local look = Camera.CFrame.LookVector
    local dir = (part.Position - Camera.CFrame.Position).Unit
    local dot = math.clamp(look:Dot(dir), -1, 1)
    return math.deg(math.acos(dot)) <= State.AimbotFOV / 2
end

local function hasLOS(part)
    if not State.VisibilityCheck then return true end
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = { Character, part.Parent }
    rp.IgnoreWater = true
    local hit = workspace:Raycast(Camera.CFrame.Position, part.Position - Camera.CFrame.Position, rp)
    return hit == nil
end

local function getClosestPlayerForAimbot()
    if not Camera or not RootPart then return nil end
    local best, bestD = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local head = plr.Character:FindFirstChild("Head") or plr.Character:FindFirstChild("HumanoidRootPart")
            if head then
                local wd = (head.Position - RootPart.Position).Magnitude
                if wd <= State.ESP_MaxDistance and isInFOV(head) and hasLOS(head) then
                    local sp = Camera:WorldToViewportPoint(head.Position)
                    if sp.Z > 0 then
                        local d = (Vector2.new(sp.X, sp.Y) - Camera.ViewportSize/2).Magnitude
                        if d < bestD then best = plr.Character; bestD = d end
                    end
                end
            end
        end
    end
    return best
end

local function getClosestBotForAimbot()
    if not Camera or not RootPart then return nil end
    local best, bestD = nil, math.huge
    for _, obj in ipairs(botCache) do
        if obj.Parent then
            local head = obj:FindFirstChild("Head") or obj:FindFirstChild("HumanoidRootPart")
            if head then
                local wd = (head.Position - RootPart.Position).Magnitude
                if wd <= State.ESP_MaxDistance and isInFOV(head) and hasLOS(head) then
                    local sp = Camera:WorldToViewportPoint(head.Position)
                    if sp.Z > 0 then
                        local d = (Vector2.new(sp.X, sp.Y) - Camera.ViewportSize/2).Magnitude
                        if d < bestD then best = obj; bestD = d end
                    end
                end
            end
        end
    end
    return best
end

local function getClosestHeliForAimbot()
    if not Camera or not RootPart then return nil end
    local best, bestD = nil, math.huge
    for _, obj in ipairs(heliCache) do
        if obj.Parent then
            local part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            if part then
                local wd = (part.Position - RootPart.Position).Magnitude
