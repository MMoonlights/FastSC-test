    keybindLabelRef = nil
end
pickerClose.MouseButton1Click:Connect(closeKeybindPicker)

local function applyKeybind()
    if not keybindTarget then return end
    local raw = pickerInput.Text:gsub("%s", "")
    if raw == "" then return end
    local kc = keyCodeFromName(raw)
    if not kc then pickerTitle.Text = "Invalid key: " .. raw; return end
    State[keybindTarget] = kc
    if keybindLabelRef then keybindLabelRef.Text = tostring(kc.Name) end
    refreshKeybindList()
    closeKeybindPicker()
end
pickerApply.MouseButton1Click:Connect(applyKeybind)

