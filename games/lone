local hitboxRestore = {}
local function applyHitboxExpand()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                if not hitboxRestore[hrp] then
                    hitboxRestore[hrp] = {Size = hrp.Size, CanCollide = hrp.CanCollide, Massless = hrp.Massless}
                end
                local s = State.HitboxSize
                hrp.Size = Vector3.new(s, s, s)
                hrp.CanCollide = false
                hrp.Massless = true
            end
        end
    end
end
local function restoreHitbox()
    for hrp, data in pairs(hitboxRestore) do
        if hrp and hrp.Parent then
            hrp.Size = data.Size
            hrp.CanCollide = data.CanCollide
            hrp.Massless = data.Massless
        end
    end
    hitboxRestore = {}
end

