local function isPlayerAlive(plr)
    if not plr or plr == LocalPlayer then return false end
    local char = plr.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function isSameTeam(plr)
    if not State.SilentAimTeam then return false end
    return plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team
end

local function isTargetVisible(part, targetChar)
    if not State.SilentAimVisible then return true end
    local origin = Camera.CFrame.Position
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = { Character, targetChar }
    rp.IgnoreWater = true
    local hit = workspace:Raycast(origin, part.Position - origin, rp)
    return hit == nil
end

local function getTargetPartInChar(char)
    local best, bestD = nil, math.huge
    for _, name in ipairs(State.SilentAimTargetParts) do
        local p = char:FindFirstChild(name)
        if p then
            local sp = Camera:WorldToViewportPoint(p.Position)
            if sp.Z > 0 then
                local d = (Vector2.new(sp.X, sp.Y) - Vector2.new(Mouse.X, Mouse.Y)).Magnitude
                if d < bestD then best, bestD = p, d end
            end
        end
    end
    return best
end

local function silentUpdateCircle()
    if silentCircleDraw then
        silentCircleDraw.Visible = State.SilentAimShowFOV and State.SilentAim and not IS_XENO
        silentCircleDraw.Radius = State.SilentAimFOV * 3
        silentCircleDraw.Position = Vector2.new(Mouse.X, Mouse.Y + GuiService:GetGuiInset().Y)
        silentCircleDraw.NumSides = State.SilentAimFOVSides
    end
end

local function silentFindTarget()
    if IS_XENO or not State.SilentAim then
        SilentSelected = nil
        SilentSelectedPart = nil
        return
    end
    local bestPart, bestChar, bestPlayer = nil, nil, nil
    local bestDist = math.huge
    local fovPx = State.SilentAimFOV * 3

    if State.SilentAimPlayers then
        for _, plr in ipairs(Players:GetPlayers()) do
            if isPlayerAlive(plr) and not isSameTeam(plr) then
                local char = plr.Character
                local part = getTargetPartInChar(char)
                if part then
                    local sp = Camera:WorldToViewportPoint(part.Position)
                    local mag = (Vector2.new(sp.X, sp.Y) - Vector2.new(Mouse.X, Mouse.Y)).Magnitude
                    if mag < fovPx and mag < bestDist then
                        if isTargetVisible(part, char) then
                            bestPart, bestChar, bestPlayer, bestDist = part, char, plr, mag
                        end
                    end
                end
            end
        end
    end

    if State.SilentAimBots then
        for _, obj in ipairs(botCache) do
            if obj.Parent then
                local hum = obj:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local part = getTargetPartInChar(obj)
                    if part then
                        local sp = Camera:WorldToViewportPoint(part.Position)
                        local mag = (Vector2.new(sp.X, sp.Y) - Vector2.new(Mouse.X, Mouse.Y)).Magnitude
                        if mag < fovPx and mag < bestDist then
                            if isTargetVisible(part, obj) then
                                bestPart, bestChar, bestPlayer, bestDist = part, obj, obj, mag
                            end
                        end
                    end
                end
            end
        end
    end

    SilentSelected = bestPlayer
    SilentSelectedPart = bestPart
end

