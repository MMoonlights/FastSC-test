local function applyRemoveLeaves(on)
    if on then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") or obj:IsA("Model") then
                local n = obj.Name:lower()
                if n:find("leaf") or n:find("leaves") or n:find("foliage") or n:find("canopy") then
                    if obj:IsA("BasePart") then
                        if obj.Transparency < 1 and not removedLeaves[obj] then
