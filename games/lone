UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end

    if input.KeyCode == Enum.KeyCode.Insert or input.KeyCode == Enum.KeyCode.RightShift then
        mainFrame.Visible = not mainFrame.Visible
    end
    if input.KeyCode == State.AimbotKey then aimbotActive = true end
    if input.KeyCode == State.FlyKey then
        State.Fly = not State.Fly
        if State.Fly then enableFly() else disableFly() end
    end
    if input.KeyCode == State.NoclipKey then
        State.Noclip = not State.Noclip
        if State.Noclip then enableNoclip() else disableNoclip() end
    end
    if input.KeyCode == State.ZoomKey then
        State.Zoom = true
        enableZoom()
    end
    if input.KeyCode == State.SpeedKey then
        State.Speed = not State.Speed
        if State.Speed then enableSpeed() else disableSpeed() end
    end
    if input.KeyCode == State.AntiFallKey then
        State.AntiFall = not State.AntiFall
        if State.AntiFall then enableAntiFall() else disableAntiFall() end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == State.AimbotKey then aimbotActive = false end
    if input.KeyCode == State.ZoomKey then
        State.Zoom = false
        disableZoom()
    end
end)

-- ==================== MAIN LOOP ====================
local fpsCount, fpsTimer, lastFps = 0, 0, 0
local targetTimer, TARGET_REFRESH = 0, 1/30
local textTimer, TEXT_INTERVAL = 0, 0.15
local silentTimer, SILENT_REFRESH = 0, 1/60

RunService.RenderStepped:Connect(function(dt)

    fpsCount = fpsCount + 1
    fpsTimer = fpsTimer + dt
    if fpsTimer >= 1 then lastFps = fpsCount; fpsCount = 0; fpsTimer = 0 end
    if State.Watermark then
        watermark.Visible = true
        watermark.Text = string.format("QWERTY-HUB v6.4 | FPS: %d", lastFps)
    else watermark.Visible = false end
    keybindList.Visible = State.KeybindList
    if State.KeybindList then refreshKeybindList() end

    fovCircle.Visible = State.FOVCircle
    if State.FOVCircle and Camera then
        local vp = Camera.ViewportSize
        local camFOV = math.rad(Camera.FieldOfView)
        local aimFOV = math.rad(State.AimbotFOV)
        local px = (vp.Y / 2) * (math.tan(aimFOV / 2) / math.tan(camFOV / 2))
        fovCircle.Size = UDim2.new(0, px * 2, 0, px * 2)
        fovStroke.Transparency = State.FOVCircleTransparency
        if State.FOV_RGB then
            local hue = (tick() * State.FOV_RGB_Speed * 0.3) % 1
            fovStroke.Color = Color3.fromHSV(hue, 1, 1)
        else fovStroke.Color = THEME.Accent end
    end

    crosshairContainer.Visible = State.Crosshair
    crosshairContainer.Position = UDim2.new(0.5, 0, 0.5, 0)
    if State.Crosshair then
        local spin = State.CH_Spin / 100 * 3600
        crosshairContainer.Rotation = (tick() * spin) % 360
        local col
        if State.CH_RGB or State.CH_Mode == "swastika" or State.CH_Mode == "star" then
            local speed = State.CH_Mode == "cross" and State.CH_RGB_Speed or 10
            local hue = (tick() * speed * 0.3) % 1
            col = Color3.fromHSV(hue, 1, 1)
        else col = State.CH_Color end
        for _, l in ipairs(chLines) do
            if l and l.Parent then l.BackgroundColor3 = col end
        end
    end

    if State.HitboxExpand then applyHitboxExpand() end

    silentTimer = silentTimer + dt
    if silentTimer >= SILENT_REFRESH then
        silentTimer = 0
        silentUpdateCircle()
        silentFindTarget()
    end

    if xrayActive then
        xrayTimer = xrayTimer + dt
        if xrayTimer >= XRAY_RESCAN then
            xrayTimer = 0
            xrayScanOnce()
        end
    end

    cacheTimer = cacheTimer + dt
    if cacheTimer >= CACHE_INTERVAL then
        cacheTimer = 0
        botCache = {}; heliCache = {}; itemCache = {}
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") then
                if (State.ESP_Bots or State.AimbotBots or State.SilentAimBots) and isBot(obj) then
                    table.insert(botCache, obj)
                end
                if (State.ESP_Heli or State.AimbotHeli) and isHeli(obj) then
                    table.insert(heliCache, obj)
                end
            end
            if State.ItemESP and (obj:IsA("Model") or obj:IsA("Tool")) and isItem(obj) then
                table.insert(itemCache, obj)
            end
        end
    end

    textTimer = textTimer + dt
    local updateText = textTimer >= TEXT_INTERVAL
    if updateText then textTimer = 0 end

    if State.PlayerESP and RootPart then
        for plr, d in pairs(playerEsp) do
            local char = plr.Character
            if char and char.Parent then
                local hum = char:FindFirstChildOfClass("Humanoid")
                local head = char:FindFirstChild("Head")
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hum and head and hrp and hum.Health > 0 then
                    local ts = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.7, 0))
                    local bs = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                    if ts.Z > 0 and bs.Z > 0 then
                        local h = math.max(math.abs(bs.Y - ts.Y), 80)
                        local w = h * 0.55
                        d.container.Position = UDim2.new(0, ts.X - w/2, 0, ts.Y)
                        d.container.Size = UDim2.new(0, w, 0, h)
                        d.container.Visible = true
                        d.box.Visible = State.ESP_Box
                        d.nameLbl.Visible = State.ESP_Name
                        d.distLbl.Visible = State.ESP_Distance
                        d.hpBar.Visible = State.ESP_Health
                        if updateText and State.ESP_Name then d.nameLbl.Text = plr.Name end
                        if updateText and State.ESP_Distance then
                            d.distLbl.Text = string.format("%d m", math.floor((head.Position - RootPart.Position).Magnitude))
                        end
                        if State.ESP_Health and hum.MaxHealth > 0 then
                            local r = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                            d.hpFill.Size = UDim2.new(r, 0, 1, 0)
                            d.hpFill.BackgroundColor3 = r > 0.6 and Color3.fromRGB(0,220,90) or (r > 0.3 and Color3.fromRGB(255,200,0) or Color3.fromRGB(255,50,50))
                        end
                        if State.ESP_PlayerInfo then
                            d.infoLbl.Visible = true
                            if updateText then
                                local tool = char:FindFirstChildOfClass("Tool")
                                d.infoLbl.Text = "[" .. (tool and tool.Name or "Unarmed") .. "]"
                            end
                        else d.infoLbl.Visible = false end
                    else d.container.Visible = false end
                else d.container.Visible = false end
            else d.container.Visible = false end
        end
    else
        for _, d in pairs(playerEsp) do d.container.Visible = false end
    end

    if State.Chams then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                applyChams(plr.Character)
            end
        end
    else
        for _, h in pairs(playerHighlight) do
            if h and h.Parent then h.Enabled = false end
        end
    end

    if State.SkeletonESP and HAS_DRAWING then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local char = plr.Character
                if not playerSkeleton[char] then
                    local segs = {}
                    for i = 1, #SKELETON_BONES do
                        local line = Drawing.new("Line")
                        line.Thickness = 1
                        line.Transparency = 1
                        line.Color = State.SkeletonColor
                        line.Visible = false
                        segs[i] = line
                    end
                    playerSkeleton[char] = segs
                end
                local segs = playerSkeleton[char]
                for i, bone in ipairs(SKELETON_BONES) do
                    local a = char:FindFirstChild(bone[1])
                    local b = char:FindFirstChild(bone[2])
                    local line = segs[i]
                    if a and b then
                        local sp1, on1 = Camera:WorldToViewportPoint(a.Position)
                        local sp2, on2 = Camera:WorldToViewportPoint(b.Position)
                        if on1 and on2 then
                            line.From = Vector2.new(sp1.X, sp1.Y)
                            line.To = Vector2.new(sp2.X, sp2.Y)
                            line.Color = State.SkeletonColor
                            line.Visible = true
                        else line.Visible = false end
                    else line.Visible = false end
                end
            end
        end
        for char, segs in pairs(playerSkeleton) do
            if not char.Parent then
                for _, s in ipairs(segs) do pcall(function() s:Remove() end) end
                playerSkeleton[char] = nil
            end
        end
    else
        for _, segs in pairs(playerSkeleton) do
            for _, s in ipairs(segs) do s.Visible = false end
        end
    end

    -- ==================== TRACER (fixed) ====================
    if State.Tracer and HAS_DRAWING and RootPart then
        local originScreen = Camera:WorldToViewportPoint(RootPart.Position)
        local originVec = Vector2.new(originScreen.X, originScreen.Y)

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local head = plr.Character:FindFirstChild("Head")
                    if head then
                        local dist = (head.Position - RootPart.Position).Magnitude
                        if dist <= State.TracerMaxDistance then
                            if not drawTracers[plr] then
                                local line = Drawing.new("Line")
                                line.Thickness = State.TracerThickness
                                line.Transparency = 1
                                line.Color = State.TracerColor
                                line.Visible = false
                                drawTracers[plr] = line
                            end
                            local sp = Camera:WorldToViewportPoint(head.Position)
                            local line = drawTracers[plr]
                            if sp.Z > 0 and originScreen.Z > 0 then
                                line.From = originVec
                                line.To = Vector2.new(sp.X, sp.Y)
                                line.Color = State.TracerColor
                                line.Thickness = State.TracerThickness
                                line.Visible = true
                            else
                                line.Visible = false
                            end
                        else
                            if drawTracers[plr] then drawTracers[plr].Visible = false end
                        end
                    end
                else
                    if drawTracers[plr] then drawTracers[plr].Visible = false end
                end
            end
        end

        -- cleanup dead / left players
        for plr, line in pairs(drawTracers) do
            if not plr.Parent or not plr.Character then
                pcall(function() line:Remove() end)
                drawTracers[plr] = nil
            end
        end
    else
        for _, line in pairs(drawTracers) do line.Visible = false end
    end

    if State.ESP_Bots and RootPart then
        for m, _ in pairs(botEsp) do
            if not m.Parent or not m:FindFirstChildOfClass("Humanoid") or m:FindFirstChildOfClass("Humanoid").Health <= 0 then
                removeBotESP(m)
            end
        end
        for _, obj in ipairs(botCache) do
            if obj.Parent then
                if not botEsp[obj] then createBotESP(obj) end
                local d = botEsp[obj]
                local hum = obj:FindFirstChildOfClass("Humanoid")
                local head = obj:FindFirstChild("Head") or obj:FindFirstChild("HumanoidRootPart")
                local hrp = obj:FindFirstChild("HumanoidRootPart") or head
                if hum and head and hrp then
                    local ts = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1.5, 0))
                    local bs = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 2.5, 0))
                    if ts.Z > 0 and bs.Z > 0 then
                        local h = math.max(math.abs(bs.Y - ts.Y), 80)
                        local w = h * 0.55
                        d.container.Position = UDim2.new(0, ts.X - w/2, 0, ts.Y)
                        d.container.Size = UDim2.new(0, w, 0, h)
                        d.container.Visible = true
                        d.nameLbl.Visible = true
                        d.distLbl.Visible = true
                        d.box.Visible = true
                        d.hpBar.Visible = true
                        if updateText then d.nameLbl.Text = obj.Name end
                        if updateText then
                            d.distLbl.Text = string.format("BOT %d m", math.floor((head.Position - RootPart.Position).Magnitude))
                        end
                        if hum.MaxHealth > 0 then
                            d.hpFill.Size = UDim2.new(math.clamp(hum.Health / hum.MaxHealth, 0, 1), 0, 1, 0)
                        end
                    else d.container.Visible = false end
                else d.container.Visible = false end
            end
        end
    else
        for m, _ in pairs(botEsp) do removeBotESP(m) end
    end

    if State.ESP_Heli and RootPart then
        for m, _ in pairs(heliEsp) do if not m.Parent then removeHeliESP(m) end end
        for _, obj in ipairs(heliCache) do
            if obj.Parent then
                if not heliEsp[obj] then createHeliESP(obj) end
                local d = heliEsp[obj]
                local part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                if part then
                    local sp = Camera:WorldToViewportPoint(part.Position)
                    if sp.Z > 0 then
                        d.container.Position = UDim2.new(0, sp.X - 40, 0, sp.Y - 25)
                        d.container.Size = UDim2.new(0, 80, 0, 50)
                        d.container.Visible = true
                        d.nameLbl.Visible = true
                        d.distLbl.Visible = true
                        d.box.Visible = true
                        d.hpBar.Visible = false
                        if updateText then d.nameLbl.Text = "HELI: " .. obj.Name end
                        if updateText then
                            d.distLbl.Text = string.format("%d m", math.floor((part.Position - RootPart.Position).Magnitude))
                        end
                    else d.container.Visible = false end
                end
            end
        end
    else
        for m, _ in pairs(heliEsp) do removeHeliESP(m) end
    end

    if State.ItemESP and RootPart then
        for m, _ in pairs(itemEspMap) do if not m.Parent then removeItemESP(m) end end
        for _, obj in ipairs(itemCache) do
            if obj.Parent then
                if not itemEspMap[obj] then createItemESP(obj) end
                local d = itemEspMap[obj]
                local part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                if part then
                    local sp = Camera:WorldToViewportPoint(part.Position)
                    if sp.Z > 0 then
                        d.container.Position = UDim2.new(0, sp.X - 40, 0, sp.Y - 15)
                        d.container.Size = UDim2.new(0, 80, 0, 30)
                        d.container.Visible = true
                        d.nameLbl.Visible = true
                        d.distLbl.Visible = true
                        d.box.Visible = true
                        d.hpBar.Visible = false
                        if updateText then d.nameLbl.Text = obj.Name end
                        if updateText then
                            d.distLbl.Text = string.format("%d m", math.floor((part.Position - RootPart.Position).Magnitude))
                        end
                    else d.container.Visible = false end
                end
            end
        end
    else
        for m, _ in pairs(itemEspMap) do removeItemESP(m) end
    end

    targetTimer = targetTimer + dt
    if aimbotActive then
        if State.Aimbot and targetTimer >= TARGET_REFRESH then
            targetTimer = 0
            currentAimbotTarget = getClosestPlayerForAimbot()
        end
        if State.Aimbot and currentAimbotTarget then aimAt(currentAimbotTarget, true) end
        if State.AimbotBots then
            local b = getClosestBotForAimbot()
            if b then aimAt(b, true) end
        end
        if State.AimbotHeli then
            local h = getClosestHeliForAimbot()
            if h then aimAt(h, true) end
        end
    end
end)

