local function applyRemoveGrass(on)
    if on then
        pcall(function()
            savedTerrainDecoration = workspace.Terrain.Decoration
            workspace.Terrain.Decoration = false
        end)
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                local n = obj.Name:lower()
                if (n:find("grass") or n:find("bush") or n:find("shrub")) and obj.Transparency < 1 then
                    if not removedGrass[obj] then
                        removedGrass[obj] = obj.Transparency
                        obj.Transparency = 1
                    end
                end
            end
        end
    else
        pcall(function()
            workspace.Terrain.Decoration = savedTerrainDecoration
        end)
        for p, t in pairs(removedGrass) do
            if p and p.Parent then p.Transparency = t end
        end
        removedGrass = {}
    end
